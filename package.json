{
	"name": "note-site-builder",
	"version": "0.1.0",
	"description": "Obsidian plugin: turn a note into a single-page website and PDF.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"author": "Quillan Favey",
	"license": "MIT",
	"type": "commonjs",
	"devDependencies": {
		"@types/node": "^26.6.3",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.28.2",
		"obsidian": "^1.13.1",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"marked": "^18.0.14",
		"marked-smartypants": "^1.1.12"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin"
	]
}
