{
	"name": "note-site-builder",
	"version": "0.6.0",
	"description": "Obsidian plugin: turn a note into a single-page website and PDF.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && eslint src && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint src"
	},
	"author": "daggermaster3000",
	"license": "MIT",
	"type": "commonjs",
	"devDependencies": {
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.3",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "^1.13.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0"
	},
	"dependencies": {
		"marked": "^18.0.14",
		"marked-smartypants": "^1.1.12"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin"
	]
}
